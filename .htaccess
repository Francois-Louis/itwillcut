# Bloquer tout accès direct aux fichiers PHP du module
<FilesMatch "\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Autoriser les assets (JS/CSS/images/fonts)
<FilesMatch "\.(css|js|jpe?g|png|gif|webp|bmp|svg|ico|woff2?|ttf|eot)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Allow from all
  </IfModule>
</FilesMatch>

Options -Indexes
